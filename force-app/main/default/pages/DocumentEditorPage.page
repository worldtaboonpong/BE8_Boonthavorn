            function saveDocument() {
                debugger;
                let editorData = editor.getData();
                let element = editor.element;
                console.log(editor.getData());
                const htmlData = String(editorData.replaceAll(/<p style="text-align:center"><img/g, '<p style="text-align:center"><img')
                    .replaceAll(/<strong/g, '<strong class="fontBold"')
                    .replaceAll(/font-family:.*?;/g, '')
                    .replaceAll(/<table border="1" cellpadding="1" cellspacing="1"/g, '<table class="tableFormEditor"'));

                console.log('htmlData', htmlData);
                debugger;

                Visualforce.remoting.Manager.invokeAction(
                    '{!$RemoteAction.PDFContentEditorController.saveDataCKEditorNew}',
                    htmlData,
                    '{!recordId}',
                    function (result, event) {
                        debugger
                        console.log('Success');
                        // window.location.reload();

                        let saveStatus = document.getElementById("saveStatus");
                        if (event.statusCode == 200) {
                            saveStatus.innerHTML = '{!$Label.PDFContent_SaveSucces}';
                            saveStatus.className = "success";
                        }
                        else {
                            saveStatus.innerHTML = '{!$Label.PDFContent_SaveFail}' + ': ' + event.message;
                            saveStatus.className = "fail";
                        }
                    }
                );
