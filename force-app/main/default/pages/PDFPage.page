<apex:page controller="PDFRenderController" renderAs="PDF" applyHtmlTag="false" applyBodyTag="false" showHeader="false" standardStylesheets="false"
    docType="HTML-5.0">
    <html>

    <head>
        <style type="text/css">
            /* *{
                font-family: cordia;
            } */

            img {
                display: block;
                page-break-after: avoid;
                position: relative;
                image-orientation: from-image;
            }

            img.pagebreak {
                display: block;
                page-break-after: auto;
                page-break-inside: avoid;
                position: relative;
            }

            table {
                /* border-collapse: collapse;
                width: 100%;
                page-break-after: avoid;
                page-break-before: avoid; */
                /* border:none; */
                border-collapse: collapse;
					/* border: 1px solid #2d2d2d; */
					width: 100%;
					page-break-inside: auto;
					/* page-break-after: avoid; */
                    /* break-after:avoid */
                    /* page-break-before: avoid; */
                    /* border: 1px solid blue ; */
            }

            table + table{
                page-break-inside: avoid;
            }
            p + table{
                page-break-inside: avoid;
            }
            

            tr {
                page-break-inside: avoid;
                page-break-after: auto;
            }

            th,
            td {
                /* border: 1px solid black; */
            }

            table.a {
                table-layout: auto;
                width: 180px;
            }

            table.b {
                table-layout: fixed;
                width: 180px;
            }

            table.c {
                table-layout: auto;
                width: 100%;
            }

            table.d {
                table-layout: fixed;
                width: 100%;
            }

            body {
                font-family: Arial Unicode MS;
                font-size: 12px;
                line-height: 1.2;
            }

            font {
                font-family: Arial Unicode MS !important;
                font-size: 12px;
                line-height: 1.2;
            }
            center{
                page-break-after: avoid;
            }

            /* p:has(>table) table{
                line-height: 1.2;
                margin-top: 3px;
                margin-bottom: 0em;
                padding: 0px;
                page-break-inside: auto;
                page-break-after: avoid;
                border: 1px solid green;
                 page-break-inside: avoid; 
                 page-break-after: auto; 
            } */

            p {
                line-height: 1.2;
                margin-top: 3px;
                margin-bottom: 0em;
                padding: 0px;
                padding-top: 2px; 
                /* page-break-before: avoid; */
                page-break-inside: avoid;
                page-break-after: auto;
                white-space: normal
                /* border: 1px solid red ; */
            }

            /* table + table{
                page-break-after: auto;
            } */
            
            /* table + p{
                page-break-after: auto;
            } */

            @page: first {
                /* margin-top: 1.5cm; */
            }

            @Page {
                size: 8.5in 11in;
                margin:0.7cm 1.5cm;
                /* margin-top: 3cm; */
                /* margin-bottom: 0.5cm; */
                overflow-x: auto;
                word-wrap: break-word;

                /* add page's header and footer */
                @top-left {
                    content: element(header-section);
                }
                @top-center {
                    content: element(header) ;
                }

                @bottom-center{
                    content: 'Page ' counter(page) ' of ' counter(pages) " " element(footer);
                    font-size:10px;
}
                /* @top-center{
                    content : element(headers);
                } */
            }

            span{
                overflow-wrap: break-word;
                white-space: normal
            }


            /* sets the header as the matching element */

            .header-section {
                position: running(header-section);
                left: 0;
                right: 0;
                height: 30px;
                background: #eeeeee;
            }

            /* sets the footer as the matching element */

            .footer-section {
                position: running(footer-section);
                left: 0;
                right: 0;
                height: 30px;
                background: #cccccc;
            }

            /* add the page number to any matching elements */

            .page-number:before {
                content: counter(page);
            }

            /* add the page total to any matching elements */

            .page-count:before {
                content: counter(pages);
            }

            /** tms_PDFRoomFloorPage styling */


            .roomFloorPage .one-colspan-th {
                background-color: silver;
                text-align: center !important;
                border: 1px solid #2d2d2d;
            }

            .roomFloorPage .one-colspan-footer {
                background-color: silver;
                border: 1px solid #2d2d2d;
            }

            .roomFloorPage .one-colspan-footer-number {
                background-color: silver;
