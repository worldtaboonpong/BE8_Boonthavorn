                border: 1px solid #2d2d2d;
            }

            /** tms_PDFRoomFloorPage styling */
            .text-container{
                width: 100%;
                /* word-wrap: break-word; */
                /* overflow-wrap: break-word; */
                word-break: break-all;
                white-space: normal;
            }

            .contractWording{
