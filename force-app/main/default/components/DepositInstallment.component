<apex:component controller="DepositInstallmentController" access="global">
    <apex:attribute name="conId" assignTo="{!contractId}"  type="Id" description="Contract Id" />
    <table >
        <tr>
            <th>Installment</th>
            <th>Installment Amount</th>
            <th>VAT (Service Only)</th>
            <th>Installment Amount with VAT</th>
            <th>Payment Method</th>
            <th>Payment Due Date</th>
            <th>Remark</th>
        </tr>
        <apex:repeat value="{!DepositInstallments}" var="install"  >
        <tr>
            <td>งวดที่ {!install.InstallmentNumber} Security Deposit</td>
            <td> 
                <apex:outputText value="{0,number, ###,###.##}">
                    <apex:param value="{!install.InstallmentAmount}"/>
                </apex:outputText>
            </td>
            <td>
                <apex:outputText value="{0,number, ###,###.##}">
                    <apex:param value="{!install.InstallmentVAT}"/>
                </apex:outputText>
            </td>
            <td>
                <apex:outputText value="{0,number, ###,###.##}">
                    <apex:param value="{!install.InstallmentAmountWithVat}"/>
                </apex:outputText>
            </td>
            <td>{!install.PaymentMethod}</td>
            <td>
                <apex:outputText value="{0,date,dd' 'MMMMM' 'yyyy}">
                    <apex:param value="{!install.PaymentDueDate}" /> 
                </apex:outputText>
            </td>
            <td>{!install.remark}</td>
        </tr>
    </apex:repeat>
    </table>
</apex:component>